# ════════════════════════════════════════════════════════════════
#  E-Commerce Platform — 環境變數範本
#  複製此檔為 .env 並填入真實值，.env 已加入 .gitignore
# ════════════════════════════════════════════════════════════════

# ── MySQL ─────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=ecommerce

# ── MongoDB ───────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password

# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# ── JWT ───────────────────────────────────────────────────────
# 至少 256-bit，建議用 openssl rand -hex 32 生成
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-long
JWT_EXPIRATION=86400000

# ── Spring Cloud Config Server ────────────────────────────────
CONFIG_SERVER_USERNAME=admin
CONFIG_SERVER_PASSWORD=your_config_password
# 本機開發：config-repo 相對路徑；生產：改為 git URI
CONFIG_REPO_PATH=./config-repo

# ── Eureka ────────────────────────────────────────────────────
EUREKA_USERNAME=admin
EUREKA_PASSWORD=your_eureka_password

# ── Zipkin ────────────────────────────────────────────────────
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ── 應用服務 Ports ────────────────────────────────────────────
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
